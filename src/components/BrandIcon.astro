---
interface Props {
  icon: {
    icon: [number, number, string[], string, string | string[]];
  };
  size?: number;
}

const { icon, size = 24 } = Astro.props;
const [width, height, , , pathData] = icon.icon;
const paths = Array.isArray(pathData) ? pathData : [pathData];
---

<svg
  width={size}
  height={size}
  viewBox={`0 0 ${width} ${height}`}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {paths.map((path) => <path d={path}></path>)}
</svg>
