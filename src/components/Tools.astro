---
import { profile } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";
---

<section class="content-section" id="tools" data-reveal>
  <SectionHeading eyebrow="Toolbox" title="Tools & Skills" />

  <ul class="tools-grid" aria-label="Tools and skills">
    {profile.tools.map((tool) => <li>{tool}</li>)}
  </ul>
</section>
