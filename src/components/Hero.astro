---
import { ArrowRight, BriefcaseBusiness, FolderOpen } from "@lucide/astro";
import { profile } from "../data/profile";
import Stats from "./Stats.astro";
---

<section class="hero-section" id="home" data-entry="hero">
  <div class="hero-content">
    <h1>
      <span>Data</span>
      <span>Scientist</span>
    </h1>
    <p class="hero-headline">{profile.headline}</p>
    <Stats />

    <div class="focus-grid" aria-label="Featured navigation">
      <a class="focus-card focus-card--orange" href="#projects">
        <FolderOpen
          class="focus-card__icon"
          size={34}
          strokeWidth={1.8}
          aria-hidden="true"
        />
        <div class="focus-card__footer">
          <div class="focus-card__copy">
            <span class="focus-card__label">Selected work</span>
            <h2>Explore my projects</h2>
          </div>
          <span class="focus-card__arrow" aria-hidden="true">
            <ArrowRight size={20} strokeWidth={2} />
          </span>
        </div>
      </a>
      <a class="focus-card focus-card--green" href="#experience">
        <BriefcaseBusiness
          class="focus-card__icon"
          size={34}
          strokeWidth={1.8}
          aria-hidden="true"
        />
        <div class="focus-card__footer">
          <div class="focus-card__copy">
            <span class="focus-card__label">My background</span>
            <h2>View my experience</h2>
          </div>
          <span class="focus-card__arrow" aria-hidden="true">
            <ArrowRight size={20} strokeWidth={2} />
          </span>
        </div>
      </a>
    </div>
  </div>
</section>
