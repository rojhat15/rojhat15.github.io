---
import { faGithub, faLinkedinIn } from "@fortawesome/free-brands-svg-icons";
import BrandIcon from "./BrandIcon.astro";
import { profile } from "../data/profile";
---

<aside class="profile-card" aria-label="Profile summary" data-entry="profile">
  <div class="profile-visual" aria-hidden="true">
    <div class="profile-portrait">
      <span class="portrait-initials">RY</span>
    </div>
  </div>

  <div class="profile-card__body">
    <h2>{profile.name}</h2>
    <p>{profile.intro}</p>
  </div>

  <div class="profile-links" aria-label="Profile links">
    <a
      href="https://www.linkedin.com/in/rojhat-yildirim/"
      target="_blank"
      rel="noreferrer"
      aria-label="LinkedIn"
      title="LinkedIn"
    >
      <BrandIcon icon={faLinkedinIn} size={25} />
    </a>
    <a
      href="https://github.com/rojhat15"
      target="_blank"
      rel="noreferrer"
      aria-label="GitHub"
      title="GitHub"
    >
      <BrandIcon icon={faGithub} size={25} />
    </a>
  </div>
</aside>
