---
import {
  ArrowUpRight,
  BrainCircuit,
  ChevronLeft,
  ChevronRight,
  ExternalLink,
  PanelsTopLeft,
  ScanLine,
  X,
} from "@lucide/astro";
import { profile } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";

const projectVisuals = {
  "punch-ai": ScanLine,
  "ai-workflows": BrainCircuit,
  "personal-portfolio": PanelsTopLeft,
};
---

<section class="content-section" id="projects" data-reveal>
  <SectionHeading eyebrow="Selected work" title="Projects" />

  <div class="project-list">
    {
      profile.projects.map((project) => {
        const Icon =
          projectVisuals[project.id as keyof typeof projectVisuals];

        return (
          <article class="project-card">
            <div
              class:list={[
                "project-card__visual",
                project.thumbnail && "project-card__visual--image",
                project.thumbnail && `project-card__visual--${project.id}`,
              ]}
              aria-hidden="true"
            >
              {project.thumbnail ? (
                <img
                  src={project.thumbnail.src}
                  alt=""
                  width={project.thumbnail.width}
                  height={project.thumbnail.height}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Icon size={38} strokeWidth={1.7} />
              )}
            </div>

            <div class="project-card__content">
              <div class="project-card__meta">
                <span>{project.category}</span>
              </div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </div>

            <span class="project-card__arrow" aria-hidden="true">
              <ArrowUpRight size={22} strokeWidth={2} />
            </span>

            <button
              class="project-card__open"
              type="button"
              aria-label={`View details for ${project.title}`}
              aria-haspopup="dialog"
              aria-controls="project-dialog"
              data-project-open={project.id}
            />
          </article>
        );
      })
    }
  </div>

  {
    profile.projects.map((project) => (
      <template id={`project-template-${project.id}`}>
        <article class="project-detail">
          <header class="project-detail__header project-detail__header--compact">
            <div>
              <p class="card-kicker">{project.category}</p>
              <h2>{project.title}</h2>
            </div>
          </header>

          {project.media.length > 0 && (
            <section
              class:list={[
                "project-gallery",
                `project-gallery--${project.id}`,
                project.compactGallery && "project-gallery--compact",
              ]}
              aria-label={`${project.title} media`}
              aria-roledescription="carousel"
              data-project-gallery
              tabindex="0"
            >
              <div class="project-gallery__viewport">
                {project.media.map((media, index) => (
                  <figure
                    class="project-gallery__slide"
                    data-gallery-slide={index}
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`${index + 1} of ${project.media.length}`}
                    hidden={index !== 0}
                  >
                    {media.type === "video" ? (
                      <video
                        src={media.src}
                        poster={media.poster}
                        aria-label={media.alt}
                        width={media.width}
                        height={media.height}
                        controls
                        playsinline
                        preload="metadata"
                      />
                    ) : (
                      <img
                        src={media.src}
                        alt={media.alt}
                        width={media.width}
                        height={media.height}
                        loading={index === 0 ? "eager" : "lazy"}
                        decoding="async"
                      />
                    )}
                  </figure>
                ))}
              </div>

              {project.media.length > 1 && (
                <div class="project-gallery__controls">
                  <button
                    class="project-gallery__nav"
                    type="button"
                    aria-label="Previous screenshot"
                    title="Previous screenshot"
                    data-gallery-previous
                  >
                    <ChevronLeft size={20} strokeWidth={2} aria-hidden="true" />
                  </button>

                  <div class="project-gallery__dots" aria-label="Choose screenshot">
                    {project.media.map((_, index) => (
                      <button
                        type="button"
                        aria-label={`Show screenshot ${index + 1}`}
                        aria-current={index === 0 ? "true" : undefined}
                        data-gallery-dot={index}
                      />
                    ))}
                  </div>

                  <span class="project-gallery__counter" aria-live="polite">
                    1 / {project.media.length}
                  </span>

                  <button
                    class="project-gallery__nav"
                    type="button"
                    aria-label="Next screenshot"
                    title="Next screenshot"
                    data-gallery-next
                  >
                    <ChevronRight size={20} strokeWidth={2} aria-hidden="true" />
                  </button>
                </div>
              )}
            </section>
          )}

          <div class="project-detail__body">
            <section>
              <p class="project-detail__label">Overview</p>
              <p class="project-detail__overview">{project.overview}</p>
            </section>

            <section>
              <p class="project-detail__label">Focus</p>
              <ul class="project-detail__highlights">
                {project.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </section>
          </div>

          <section class="project-detail__stack" aria-label="Technology stack">
            <p class="project-detail__label">Stack</p>
            <div class="project-detail__tools">
              {project.tools.map((tool) => <span>{tool}</span>)}
            </div>
          </section>

          {project.url && (
            <div class="project-detail__actions">
              <a href={project.url} target="_blank" rel="noreferrer">
                View project
                <ExternalLink size={17} strokeWidth={2} aria-hidden="true" />
              </a>
            </div>
          )}
        </article>
      </template>
    ))
  }

  <dialog
    class="project-dialog"
    id="project-dialog"
    aria-label="Project details"
  >
    <div class="project-dialog__shell">
      <button
        class="project-dialog__close"
        type="button"
        aria-label="Close project details"
        data-project-close
      >
        <X size={21} strokeWidth={2} aria-hidden="true" />
      </button>
      <div data-project-content></div>
    </div>
  </dialog>
</section>

<script>
  const projectDialog = document.querySelector<HTMLDialogElement>(
    "#project-dialog",
  );
  const projectContent = projectDialog?.querySelector<HTMLElement>(
    "[data-project-content]",
  );
  const projectClose = projectDialog?.querySelector<HTMLButtonElement>(
    "[data-project-close]",
  );
  const projectTriggers = document.querySelectorAll<HTMLButtonElement>(
    "[data-project-open]",
  );
  let lastProjectTrigger: HTMLButtonElement | null = null;

  const initializeProjectGallery = () => {
    const gallery = projectContent?.querySelector<HTMLElement>(
      "[data-project-gallery]",
    );

    if (!gallery) return;

    const slides = Array.from(
      gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]"),
    );
    const dots = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-dot]"),
    );
    const previousButton = gallery.querySelector<HTMLButtonElement>(
      "[data-gallery-previous]",
    );
    const nextButton = gallery.querySelector<HTMLButtonElement>(
      "[data-gallery-next]",
    );
    const counter = gallery.querySelector<HTMLElement>(
      ".project-gallery__counter",
    );
    let activeIndex = 0;

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        slide.hidden = slideIndex !== activeIndex;
      });

      gallery.querySelectorAll<HTMLVideoElement>("video").forEach((video) => {
        if (video.closest<HTMLElement>("[data-gallery-slide]")?.hidden) {
          video.pause();
        }
      });

      dots.forEach((dot, dotIndex) => {
        if (dotIndex === activeIndex) {
          dot.setAttribute("aria-current", "true");
        } else {
          dot.removeAttribute("aria-current");
        }
      });

      if (counter) counter.textContent = `${activeIndex + 1} / ${slides.length}`;
    };

    previousButton?.addEventListener("click", () => showSlide(activeIndex - 1));
    nextButton?.addEventListener("click", () => showSlide(activeIndex + 1));

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => showSlide(index));
    });

    gallery.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        showSlide(activeIndex - 1);
      }

      if (event.key === "ArrowRight") {
        event.preventDefault();
        showSlide(activeIndex + 1);
      }
    });
  };

  const closeProjectDialog = () => {
    projectDialog?.close();
  };

  projectTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const projectId = trigger.dataset.projectOpen;
      const template = document.querySelector<HTMLTemplateElement>(
        `#project-template-${projectId}`,
      );

      if (!projectDialog || !projectContent || !template) return;

      lastProjectTrigger = trigger;
      projectContent.replaceChildren(template.content.cloneNode(true));
      initializeProjectGallery();
      document.body.classList.add("project-dialog-open");
      projectDialog.showModal();

      const openingVideo = projectContent.querySelector<HTMLVideoElement>(
        "[data-gallery-slide]:not([hidden]) video",
      );

      if (openingVideo) {
        openingVideo.muted = false;
        openingVideo.volume = 1;
        openingVideo.play().catch(() => undefined);
      }
    });
  });

  projectClose?.addEventListener("click", closeProjectDialog);

  projectDialog?.addEventListener("click", (event) => {
    if (event.target === projectDialog) closeProjectDialog();
  });

  projectDialog?.addEventListener("close", () => {
    projectContent
      ?.querySelectorAll<HTMLVideoElement>("video")
      .forEach((video) => video.pause());
    document.body.classList.remove("project-dialog-open");
    lastProjectTrigger?.focus();
  });
</script>
