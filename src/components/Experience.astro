---
import { Briefcase, GraduationCap, Link2 } from "@lucide/astro";
import { profile } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";
---

<section class="content-section" id="experience" data-reveal>
  <SectionHeading eyebrow="Approach" title="Experience" />

  <div class="experience-tabs" role="tablist" aria-label="Experience sections">
    <button
      class="experience-tab is-active"
      id="work-experience-tab"
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="work-experience-panel"
      tabindex="0"
    >
      <Briefcase size={17} strokeWidth={2} aria-hidden="true" />
      <span>Work Experience</span>
    </button>
    <button
      class="experience-tab"
      id="education-tab"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="education-panel"
      tabindex="-1"
    >
      <GraduationCap size={18} strokeWidth={2} aria-hidden="true" />
      <span>Education</span>
    </button>
  </div>

  <div
    class="experience-panel"
    id="work-experience-panel"
    role="tabpanel"
    aria-labelledby="work-experience-tab"
  >
    <div class="timeline-list">
      {
        profile.experience.map((item) => (
          <article class="timeline-item experience-item">
            <div class="experience-identity">
              <div class="experience-logo">
                <img
                  src={item.logo}
                  alt={item.logoAlt}
                  width="56"
                  height="56"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div>
                <h3>{item.company}</h3>
                <p class="experience-period">{item.period}</p>
              </div>
            </div>
            <div class="experience-details">
              {
                item.description && (
                  <p class="experience-description">{item.description}</p>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div
    class="experience-panel"
    id="education-panel"
    role="tabpanel"
    aria-labelledby="education-tab"
    hidden
  >
    <div class="timeline-list">
      {
        profile.education.map((item) => (
          <article
            class:list={[
              "timeline-item",
              "experience-item",
              "education-item",
              item.relationshipRole &&
                `education-item--${item.relationshipRole}`,
            ]}
          >
            <div class="experience-identity">
              <div class="experience-logo">
                <img
                  src={item.logo}
                  alt={item.logoAlt}
                  width="56"
                  height="56"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div>
                <h3>{item.institution}</h3>
                <p class="experience-period">{item.period}</p>
              </div>
            </div>
            <div class="experience-details">
              <p class="education-qualification">{item.qualification}</p>
              {
                item.relationship && (
                  <p class="education-relationship">
                    <Link2 size={14} strokeWidth={2} aria-hidden="true" />
                    <span>{item.relationship}</span>
                  </p>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const experienceTabList = document.querySelector<HTMLElement>(
    ".experience-tabs",
  );

  if (experienceTabList) {
    const tabs = Array.from(
      experienceTabList.querySelectorAll<HTMLButtonElement>("[role='tab']"),
    );
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>(".experience-panel"),
    );

    const activateTab = (activeTab: HTMLButtonElement, moveFocus = false) => {
      tabs.forEach((tab) => {
        const isActive = tab === activeTab;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.id !== activeTab.getAttribute("aria-controls");
      });

      if (moveFocus) activeTab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateTab(tab));
      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;

        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft") {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        }
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;
        if (nextIndex === undefined) return;

        event.preventDefault();
        activateTab(tabs[nextIndex], true);
      });
    });
  }
</script>
